module CustomInputs exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

-- This schema and its factory are entirely application-authored Knot.
-- Select the root and use Circle (C). The callback doubles the stored x value.
type alias Dot = { x : Float, y : Float, size : Float, color : Color, label : String }

fresh :: Unit -> Dot
fresh _ = { x = 0, y = 0, size = 10, color = tomato, label = "new dot" }

dots :: List Dot
dots =
  [ { x = 40, y = 80, size = 24, color = tomato, label = "first dot" }
  , { x = 100, y = 120, size = 32, color = rgb 70 130 180, label = "second dot" }
  ]

program = svg 300 200 (growMap (fresh ()) (\d -> circle (d.x * 2) d.y d.size |> set_fill d.color) dots)
