-- story: A size a whole number cannot make
-- group: 1. Editing a value in place
-- status: works
-- try: Change the radius to 45. No whole number of rings gives 45, so the edit is refused and nothing is rounded.
-- reject: edit 0 r 45
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

rings :: Int
rings = 3

program = svg 240 160 [circle 120 80 (fromIntegral rings * 10) |> set_fill tomato]
