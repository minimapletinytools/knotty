-- story: Through filter
-- group: 4. Lists
-- status: works
-- try: Move a circle. Its number in the list changes; 30 is filtered out and is skipped. Moving a
--   circle to the left of 60 is refused: it would drop out of the filter.
-- check: edit 0 cx 100
-- reject: edit 0 cx 40
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

program = svg 240 160
    (map (\x -> circle x 80 18 |> set_fill tomato) (filter (\x -> x > 60) [30, 90, 150, 210]))
