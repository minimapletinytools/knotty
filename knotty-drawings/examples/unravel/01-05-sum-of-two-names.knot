-- story: Which name moves in a + b
-- group: 1. Editing a value in place
-- status: works
-- try: Change cx to 120. Either name could take the change. The default rule for + gives it to the left one.
-- check: edit 0 cx 120
-- source: left = (70.0)
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

left :: Float
left = 30

gap :: Float
gap = 50

program = svg 240 160 [circle (left + gap) 80 25 |> set_fill tomato]
