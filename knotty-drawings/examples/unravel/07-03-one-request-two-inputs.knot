-- story: One number split across two inputs
-- group: 7. Writing a rule
-- status: works
-- try: Change the radius to 47. The rule writes both inputs at once: 4 tens and 7 ones.
-- check: edit 0 r 47
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)
import DrawingUnravel

tens :: Int
tens = 3

ones :: Int
ones = 2

@unravel(🧶digits)
digits :: Int -> Int -> Int
digits high low = high * 10 + low

🧶digits :: (DrawingUnravel.Feed Int, DrawingUnravel.Feed Int) -> Maybe Int -> Maybe (Maybe Int, Maybe Int)
🧶digits _ wanted = case wanted of
    Nothing -> Just (Nothing, Nothing)
    Just total -> if total < 0 then Nothing else Just (Just (div total 10), Just (mod total 10))

program = svg 240 160 [circle 120 80 (fromIntegral (digits tens ones)) |> set_fill tomato]
