-- story: The shapes on the Bézier curve
-- group: 6. Callbacks
-- status: needs-work
-- try: Each star's size is built from a constant, a position along a curve and a random number,
--   inside a callback over a range. Change one star's points: it is refused.
-- note: This is the Bézier demo in miniature. Nothing per element can be edited: the list is a
--   range, and constants inside the callback are pinned. A scale handle reaches the shared size
--   instead; see the Whips stories.
-- wanted: edit 1 points [[95,50],[125,110],[65,110]]
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

random :: Int -> Float
random seed =
    let noise = sin (fromIntegral seed * 12.9898) * 43758.5453
    in noise - fromIntegral (floor noise)

star :: Int -> Node
star index =
    let
        size = 8 + 14 * random (index * 17)
        x = fromIntegral index * 50 + 45
        turn = add_transform (Rotate (random index * 90) (Just (x, 80)))
        filled = \shape -> shape |> set_fill tomato |> turn
    in filled
        (polygon [point x (80 - size), point (x + size) (80 + size), point (x - size) (80 + size)])

program = svg 240 160 (map star (enumFromTo 0 3))
