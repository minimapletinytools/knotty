-- story: One handle on every dot
-- group: 9. Whips
-- status: works
-- try: Select any dot and drag its round amber handle. All of them scale, and the drawing follows
--   as you drag.
-- check: whip 0 1 1.5
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

@whip(OnNodes dots (ScaleHandle "Dot scale"))
scale :: Float
scale = 1.0

dots :: List Node
dots = map dot (enumFromTo 0 3)

dot :: Int -> Node
dot i = circle (fromIntegral i * 55 + 40) 80 (scale * (8 + 4 * fromIntegral i)) |> set_fill tomato

program = svg 240 160 dots
