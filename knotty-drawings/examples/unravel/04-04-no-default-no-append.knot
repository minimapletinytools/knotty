-- story: A type with no default cannot be created
-- group: 4. Lists
-- status: works
-- try: Draw a circle. It is refused: Tag has no Default instance, so there is nothing to start a new record from.
-- reject: create circle - 160 80 25
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

type Tag = Tag String deriving Eq

type alias Dot = { x : Float, y : Float, radius : Float, tag : Tag }

dots :: List Dot
dots = [{ x = 60, y = 80, radius = 22, tag = Tag "first" }]

program = svg 240 160 (growMap (\d -> circle d.x d.y d.radius |> set_fill tomato) dots)
