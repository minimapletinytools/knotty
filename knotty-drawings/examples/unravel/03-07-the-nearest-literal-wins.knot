-- story: The nearest literal wins
-- group: 3. Moving and resizing
-- status: works
-- try: Change the width to 120. You might expect size to change and the square to grow about its centre. Only the width's own 2 changes, and it stops being a square.
-- check: edit 0 width 120
-- source: ((3.0) * size) (2 * size)
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

size :: Float
size = 40

program = svg 240 160 [rect (120 - size) (80 - size) (2 * size) (2 * size) |> set_fill tomato]
