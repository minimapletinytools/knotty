-- story: A whip for a colour
-- group: 9. Whips
-- status: needs-work
-- try: Every shape is tinted from one colour. There is no control that sets it for the whole drawing.
-- note: A whip can drive an Int or a Float. A colour control is not written.
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

tint :: Color
tint = tomato

program = svg 240 160 (map (\x -> circle x 80 20 |> set_fill tint) [60, 120, 180])
