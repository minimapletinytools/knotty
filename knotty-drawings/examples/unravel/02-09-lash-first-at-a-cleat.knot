-- story: Lash first at a cleat: one setter, then reused
-- group: 2. Setters and optional properties
-- status: works
-- try: Both rects read paint, inside their cleats. Open the fill of the first rect, tick "Add a new
--   setter" and pick a colour. A set_fill is added right after its cleat and paint is left alone.
--   Do it again with another colour: the set_fill that was added is edited, and no second one
--   appears.
-- check: lash 0 fill.paint [10,120,200]
-- check: lash 0 fill.paint [20,160,90]
-- source: paint = tomato
-- source: [@cleat (rect 20 40 90 80 |> set_fill paint) |> set_fill (Types.Rgb (20) (160) (90)), @cleat
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

paint :: Color
paint = tomato

program = svg 240 160 [@cleat (rect 20 40 90 80 |> set_fill paint), @cleat (rect 130 40 90 80 |> set_fill paint)]
