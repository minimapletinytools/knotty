-- story: Scale a shape about its centre
-- group: 3. Moving and resizing
-- status: needs-work
-- try: All four numbers come from size, so the square can only grow about its centre. A corner drag
--   holds the opposite corner still, and a move keeps the size, and this program can do neither:
--   both are refused.
-- note: The canvas has no gesture that asks only for a size and lets the position land where the
--   program puts it. The scale handle does this for a whip; ordinary shapes need the same.
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

size :: Float
size = 40

side :: Float
side = size + size

program = svg 240 160 [rect (120 - size) (80 - size) side side |> set_fill tomato]
