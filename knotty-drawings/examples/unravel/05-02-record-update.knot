-- story: A record update
-- group: 5. Records, tuples and maps
-- status: works
-- try: Move the red circle. The edit lands on the update, and the grey circle, drawn from the base
--   record, stays.
-- check: edit 1 cx 150
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)

base = { x = 70, y = 80, radius = 26 }

moved = { base | x = 170 }

program = svg 240 160
    [ circle base.x base.y base.radius |> set_fill slate_gray
    , circle moved.x moved.y moved.radius |> set_fill tomato
    ]
