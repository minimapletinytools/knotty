-- story: A rule that refuses
-- group: 7. Writing a rule
-- status: works
-- try: Change the radius to 50, then to 5. The rule refuses anything below the base, so 5 is rejected.
-- check: edit 0 r 50
-- reject: edit 0 r 5
module Story exposing (..)

import KnottyDrawings exposing (..)
import Types exposing (..)
import DrawingUnravel

base :: Float
base = 10

extra :: Float
extra = 20

@unravel(🧶atLeast)
atLeast :: Float -> Float -> Float
atLeast least more = least + more

🧶atLeast :: (DrawingUnravel.Feed Float, DrawingUnravel.Feed Float) -> Maybe Float -> Maybe (Maybe Float, Maybe Float)
🧶atLeast (least, _) wanted = case wanted of
    Nothing -> Just (Nothing, Nothing)
    Just total -> if total < least.value then Nothing else Just (Nothing, Just (total - least.value))

program = svg 240 160 [circle 120 80 (atLeast base extra) |> set_fill tomato]
