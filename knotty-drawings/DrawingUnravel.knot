module DrawingUnravel exposing (..)

import Types exposing (..)
import Constrictions exposing (..)

type alias Feed a = { value : a, pinned : Maybe a }

-- A distinct request type makes creation an explicit editableShapes policy.
-- Registering its constructor recipe does not enable growth on every Node list.
type ShapeAdditions = ShapeAdditions (ListConstriction NodeConstriction)

finiteCoordinate :: Float -> Bool
finiteCoordinate n = not (isNaN n || isInfinite n)

instance Constriction ShapeAdditions (List Node) where
  fits (ShapeAdditions request) actual = fits request actual
  materialize (ShapeAdditions request) = case request of
    Prepend (ShapeNodeRequest _ (RequestRect box)) ExactEnd -> do
      x <- box.x
      y <- box.y
      width <- box.width
      height <- box.height
      if width > 0 && height > 0 && all finiteCoordinate [x, y, width, height]
      then pure [ShapeNode defaultCommon (Rect { x = x, y = y, width = width, height = height, rx = 0, ry = 0, fill = defaultFill, stroke = defaultStroke })] else Nothing
    Prepend (ShapeNodeRequest _ (RequestEllipse oval)) ExactEnd -> do
      cx <- oval.cx
      cy <- oval.cy
      rx <- oval.rx
      ry <- oval.ry
      if rx > 0 && ry > 0 && all finiteCoordinate [cx, cy, rx, ry]
      then pure [ShapeNode defaultCommon (Ellipse { cx = cx, cy = cy, rx = rx, ry = ry, fill = defaultFill, stroke = defaultStroke })] else Nothing
    _ -> do
      (cx, cy, r) <- circleAdditionArguments { value = [], pinned = Nothing } (ShapeAdditions request)
      pure [ShapeNode defaultCommon (Circle { cx = cx, cy = cy, r = r, fill = defaultFill, stroke = defaultStroke })]

🧶editableShapes :: (Feed (List Node), Feed (List Node)) -> ListConstriction NodeConstriction -> Unravelled (ListConstriction NodeConstriction, ShapeAdditions)
🧶editableShapes (generated, additions) request = do
  (left, right) <- orSnag (splitListRequest (effectiveFeed generated) request)
  let wanted = ShapeAdditions right
  if pinAllows generated left && pinAllows additions wanted
  then Unravel (left, wanted) else Snag

unravelShapeAdditions :: (Feed Node, Feed (List Node)) -> ShapeAdditions -> Unravelled (FieldConstriction NodeConstriction, FieldConstriction ShapeAdditions)
unravelShapeAdditions _ (ShapeAdditions request) = case request of
  AnyRemainder -> Unravel (NoRequest, NoRequest)
  ExactEnd -> Snag
  Prepend head tail -> Unravel (RequestField head, RequestField (ShapeAdditions tail))

-- One new circle per creation transaction. Existing slots are decomposed above;
-- only an empty suffix is materialized. Reuse the circle's normal reverse rule
-- with a fixed factory seed, then materialize the resulting constructor value.
circleAdditionArguments :: Feed (List Node) -> ShapeAdditions -> Maybe (Float, Float, Float)
circleAdditionArguments input (ShapeAdditions request) = case input.value of
  _ : _ -> Nothing
  [] -> case request of
    Prepend wanted ExactEnd -> do
      let x = { value = 0.0, pinned = Nothing }
      let y = { value = 0.0, pinned = Nothing }
      let radius = { value = 10.0, pinned = Nothing }
      (rx, ry, rr) <- unravelledToMaybe (🧶circle (x, y, radius) wanted)
      cx <- chooseExact x rx
      cy <- chooseExact y ry
      r <- chooseExact radius rr
      if r > 0 && all finiteCoordinate [cx, cy, r]
      then Just (cx, cy, r) else Nothing
    _ -> Nothing

-- A colour back to hue, saturation and lightness. A grey has no hue, so the
-- hue is left as it is and the saturation becomes zero.
🧶hsl :: (Feed Float, Feed Float, Feed Float) -> Maybe Color -> Unravelled (Maybe Float, Maybe Float, Maybe Float)
🧶hsl _ request = case request of
  Nothing -> Unravel (Nothing, Nothing, Nothing)
  Just (Rgb red green blue) ->
    let r = fromIntegral red / 255
        g = fromIntegral green / 255
        b = fromIntegral blue / 255
        high = max r (max g b)
        low = min r (min g b)
        chroma = high - low
        lightness = (high + low) / 2
        turn = if high == r then (g - b) / chroma
               else if high == g then (b - r) / chroma + 2
               else (r - g) / chroma + 4
        hue = 60 * (if turn < 0 then turn + 6 else turn)
    in if chroma == 0 then Unravel (Nothing, Just 0, Just lightness)
       else Unravel (Just hue, Just (chroma / (1 - abs (2 * lightness - 1))), Just lightness)

-- Raw materialized constructors retain normal field routes on later edits.
unravelShapeNode :: (Feed Common, Feed Shape) -> NodeConstriction -> Unravelled (CommonConstriction, ShapeConstriction)
unravelShapeNode _ request = case request of
  AnyNode -> Unravel (anyCommon, AnyShape)
  ShapeNodeRequest common shape -> Unravel (common, shape)
  _ -> Snag

unravelCircleShape :: Feed Circle -> ShapeConstriction -> Unravelled CircleConstriction
unravelCircleShape _ request = case request of
  AnyShape -> Unravel anyCircle
  RequestCircle circle -> Unravel circle
  _ -> Snag

unravelRectShape :: Feed Rect -> ShapeConstriction -> Unravelled RectConstriction
unravelRectShape _ request = case request of
  AnyShape -> Unravel anyRect
  RequestRect rect -> Unravel rect
  _ -> Snag

unravelEllipseShape :: Feed Ellipse -> ShapeConstriction -> Unravelled EllipseConstriction
unravelEllipseShape _ request = case request of
  AnyShape -> Unravel anyEllipse
  RequestEllipse ellipse -> Unravel ellipse
  _ -> Snag

-- Rules route requests to existing source arguments. Fixed constructor defaults
-- and pins are checked by the engine before any source is published.

-- A shape function answers for its own arguments only. Anything else a request
-- asks for (a fill, a stroke, an id) has to hold already for the plain node the
-- function makes; if it does not, the rule snags, and a setter can be lashed on.
-- `rest` is the request with the function's own arguments left open.
plainEnough :: CommonConstriction -> ShapeConstriction -> Shape -> Bool
plainEnough common rest plain = fits (ShapeNodeRequest common rest) (ShapeNode defaultCommon plain)

🧶rect :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶rect _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest common geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing, Nothing)
    RequestRect r ->
      if plainEnough common (RequestRect { r | x = Nothing, y = Nothing, width = Nothing, height = Nothing }) (Rect { x = 0, y = 0, width = 0, height = 0, rx = 0, ry = 0, fill = defaultFill, stroke = defaultStroke })
      then Unravel (r.x, r.y, r.width, r.height) else Snag
    _ -> Snag
  _ -> Snag

🧶rounded_rect :: (Feed Float, Feed Float, Feed Float, Feed Float, Feed Float) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶rounded_rect _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing, Nothing, Nothing)
    RequestRect r -> case merge r.rx r.ry of
      Nothing -> Snag
      Just radius -> Unravel (r.x, r.y, r.width, r.height, radius)
    _ -> Snag
  _ -> Snag

🧶circle :: (Feed Float, Feed Float, Feed Float) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float)
🧶circle _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing)
  ShapeNodeRequest common geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing)
    RequestCircle r ->
      if plainEnough common (RequestCircle { r | cx = Nothing, cy = Nothing, r = Nothing }) (Circle { cx = 0, cy = 0, r = 0, fill = defaultFill, stroke = defaultStroke })
      then Unravel (r.cx, r.cy, r.r) else Snag
    _ -> Snag
  _ -> Snag

🧶ellipse :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶ellipse _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest common geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing, Nothing)
    RequestEllipse r ->
      if plainEnough common (RequestEllipse { r | cx = Nothing, cy = Nothing, rx = Nothing, ry = Nothing }) (Ellipse { cx = 0, cy = 0, rx = 0, ry = 0, fill = defaultFill, stroke = defaultStroke })
      then Unravel (r.cx, r.cy, r.rx, r.ry) else Snag
    _ -> Snag
  _ -> Snag

🧶line :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶line _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest common geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing, Nothing)
    RequestLine r ->
      if plainEnough common (RequestLine { r | x1 = Nothing, y1 = Nothing, x2 = Nothing, y2 = Nothing }) (Line { x1 = 0, y1 = 0, x2 = 0, y2 = 0, stroke = defaultStroke })
      then Unravel (r.x1, r.y1, r.x2, r.y2) else Snag
    _ -> Snag
  _ -> Snag

🧶text :: (Feed Float, Feed Float, Feed String) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe String)
🧶text _ request = case request of
  AnyNode -> Unravel (Nothing, Nothing, Nothing)
  ShapeNodeRequest common geometry -> case geometry of
    AnyShape -> Unravel (Nothing, Nothing, Nothing)
    RequestText r ->
      if plainEnough common (RequestText { r | x = Nothing, y = Nothing, content = Nothing }) (Text { x = 0, y = 0, content = "", font = defaultFont, fill = defaultFill, stroke = defaultStroke })
      then Unravel (r.x, r.y, r.content) else Snag
    _ -> Snag
  _ -> Snag

-- Exact list requests preserve the original number of source elements. Growth
-- still needs the engine's prepared-draft protocol; it is not silently invented.
exactList :: Maybe (List a) -> ListConstriction (Maybe a)
exactList request = case request of
  Nothing -> AnyRemainder
  Just values -> exactItems values

exactItems :: List a -> ListConstriction (Maybe a)
exactItems values = case values of
  [] -> ExactEnd
  x : xs -> Prepend (Just x) (exactItems xs)

type alias PointConstriction = { x : Maybe Float, y : Maybe Float }
pointList :: Maybe (List Point) -> ListConstriction PointConstriction
pointList request = case request of
  Nothing -> AnyRemainder
  Just values -> pointItems values

pointItems :: List Point -> ListConstriction PointConstriction
pointItems values = case values of
  [] -> ExactEnd
  p : ps -> Prepend { x = Just p.x, y = Just p.y } (pointItems ps)

🧶polyline :: Feed (List Point) -> NodeConstriction -> Unravelled (ListConstriction PointConstriction)
🧶polyline _ request = case request of
  AnyNode -> Unravel AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Unravel AnyRemainder
    RequestPolyline r -> Unravel (pointList r.points)
    _ -> Snag
  _ -> Snag

🧶polygon :: Feed (List Point) -> NodeConstriction -> Unravelled (ListConstriction PointConstriction)
🧶polygon _ request = case request of
  AnyNode -> Unravel AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Unravel AnyRemainder
    RequestPolyline r -> Unravel (pointList r.points)
    _ -> Snag
  _ -> Snag

🧶path :: Feed (List PathCommand) -> NodeConstriction -> Unravelled (ListConstriction (Maybe PathCommand))
🧶path _ request = case request of
  AnyNode -> Unravel AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Unravel AnyRemainder
    RequestPath r -> Unravel (exactList r.commands)
    _ -> Snag
  _ -> Snag

🧶group :: Feed (List Node) -> NodeConstriction -> Unravelled (ListConstriction NodeConstriction)
🧶group _ request = case request of
  AnyNode -> Unravel AnyRemainder
  ContainerNodeRequest r -> Unravel r.children
  _ -> Snag

🧶svg :: (Feed Float, Feed Float, Feed (List Node)) -> ContainerConstriction -> Unravelled (Maybe Float, Maybe Float, ListConstriction NodeConstriction)
🧶svg _ request = case request.kind of
  AnyKind -> Unravel (Nothing, Nothing, request.children)
  ViewportKind r -> Unravel (r.width, r.height, request.children)
  GroupKind -> Snag

🧶nested_svg :: (Feed Float, Feed Float, Feed (List Node)) -> NodeConstriction -> Unravelled (Maybe Float, Maybe Float, ListConstriction NodeConstriction)
🧶nested_svg inputs request = case request of
  AnyNode -> Unravel (Nothing, Nothing, AnyRemainder)
  ContainerNodeRequest r -> 🧶svg inputs r
  _ -> Snag

🧶set_view_box :: (Feed Float, Feed Float, Feed Float, Feed Float, Feed Container) -> ContainerConstriction -> Unravelled (Maybe Float, Maybe Float, Maybe Float, Maybe Float, ContainerConstriction)
🧶set_view_box _ request = case request.kind of
  ViewportKind r -> case r.viewBox of
    Just (Just b) -> Unravel (Just b.minX, Just b.minY, Just b.width, Just b.height, { request | kind = ViewportKind { r | viewBox = Nothing } })
    Just Nothing -> Snag
    Nothing -> Unravel (Nothing, Nothing, Nothing, Nothing, request)
  _ -> Unravel (Nothing, Nothing, Nothing, Nothing, request)

-- A shared style setter can affect several descendants. Merge equal requests;
-- reject incompatible ones instead of arbitrarily choosing one child.
merge :: Eq a => Maybe a -> Maybe a -> Maybe (Maybe a)
merge left right = case (left, right) of
  (Nothing, _) -> Just right
  (_, Nothing) -> Just left
  (Just a, Just b) -> if a == b then Just left else Nothing

extract :: Eq a => (ShapeConstriction -> (Maybe a, ShapeConstriction)) -> NodeConstriction -> Maybe (Maybe a, NodeConstriction)
extract take request = case request of
  AnyNode -> Just (Nothing, AnyNode)
  ShapeNodeRequest common geometry ->
    let (value, rest) = take geometry in Just (value, ShapeNodeRequest common rest)
  ContainerNodeRequest container -> case extractChildren take container.children of
    Nothing -> Nothing
    Just (value, children) -> Just (value, ContainerNodeRequest { container | children = children })

extractChildren :: Eq a => (ShapeConstriction -> (Maybe a, ShapeConstriction)) -> ListConstriction NodeConstriction -> Maybe (Maybe a, ListConstriction NodeConstriction)
extractChildren take children = case children of
  AnyRemainder -> Just (Nothing, AnyRemainder)
  ExactEnd -> Just (Nothing, ExactEnd)
  Prepend node rest -> case (extract take node, extractChildren take rest) of
    (Just (a, nodeRest), Just (b, tailRest)) -> case merge a b of
      Nothing -> Nothing
      Just value -> Just (value, Prepend nodeRest tailRest)
    _ -> Nothing

fillPaint :: ShapeConstriction -> (Maybe (Paint), ShapeConstriction)
fillPaint geometry = case geometry of
  RequestRect r -> (r.fill.paint, RequestRect { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestCircle r -> (r.fill.paint, RequestCircle { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestEllipse r -> (r.fill.paint, RequestEllipse { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestPolyline r -> (r.fill.paint, RequestPolyline { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestPath r -> (r.fill.paint, RequestPath { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestText r -> (r.fill.paint, RequestText { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_fill :: (Feed (Color), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Color), NodeConstriction)
🧶set_fill _ request = case extract fillPaint request of
  Just (Nothing, rest) -> Unravel (Nothing, rest)
  Just (Just (Solid color), rest) -> Unravel (Just color, rest)
  _ -> Snag

strokePaint :: ShapeConstriction -> (Maybe (Paint), ShapeConstriction)
strokePaint geometry = case geometry of
  RequestRect r -> (r.stroke.paint, RequestRect { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestCircle r -> (r.stroke.paint, RequestCircle { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestEllipse r -> (r.stroke.paint, RequestEllipse { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestLine r -> (r.stroke.paint, RequestLine { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestPolyline r -> (r.stroke.paint, RequestPolyline { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestPath r -> (r.stroke.paint, RequestPath { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestText r -> (r.stroke.paint, RequestText { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_stroke :: (Feed (Color), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Color), NodeConstriction)
🧶set_stroke _ request = case extract strokePaint request of
  Just (Nothing, rest) -> Unravel (Nothing, rest)
  Just (Just (Solid color), rest) -> Unravel (Just color, rest)
  _ -> Snag

🧶set_fill_paint :: (Feed (Paint), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Paint), NodeConstriction)
🧶set_fill_paint _ request = orSnag (extract fillPaint request)

🧶set_stroke_paint :: (Feed (Paint), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Paint), NodeConstriction)
🧶set_stroke_paint _ request = orSnag (extract strokePaint request)

