fontSize geometry = case geometry of
  RequestText r -> (r.font.size, RequestText { r | font = (let s = r.font in { s | size = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_font_size :: (Feed (Float), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Float), NodeConstriction)
🧶set_font_size _ request = orSnag (extract fontSize request)

fontAnchor :: ShapeConstriction -> (Maybe (TextAnchor), ShapeConstriction)
fontAnchor geometry = case geometry of
  RequestText r -> (r.font.anchor, RequestText { r | font = (let s = r.font in { s | anchor = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_text_anchor :: (Feed (TextAnchor), Feed Node) -> NodeConstriction -> Unravelled (Maybe (TextAnchor), NodeConstriction)
🧶set_text_anchor _ request = orSnag (extract fontAnchor request)

