fontBaseline geometry = case geometry of
  RequestText r -> (r.font.baseline, RequestText { r | font = (let s = r.font in { s | baseline = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_dominant_baseline :: (Feed (DominantBaseline), Feed Node) -> NodeConstriction -> Unravelled (Maybe (DominantBaseline), NodeConstriction)
🧶set_dominant_baseline _ request = orSnag (extract fontBaseline request)

🧶set_no_fill :: Feed Node -> NodeConstriction -> Unravelled NodeConstriction
🧶set_no_fill _ request = case extract fillPaint request of
  Just (Nothing, rest) -> Unravel rest
  Just (Just NoPaint, rest) -> Unravel rest
  _ -> Snag

🧶set_no_stroke :: Feed Node -> NodeConstriction -> Unravelled NodeConstriction
🧶set_no_stroke _ request = case extract strokePaint request of
  Just (Nothing, rest) -> Unravel rest
  Just (Just NoPaint, rest) -> Unravel rest
  _ -> Snag

-- Common setters affect this node only, unlike recursive style setters.
commonRequest :: NodeConstriction -> CommonConstriction
commonRequest request = case request of
  ShapeNodeRequest common _ -> common
  ContainerNodeRequest c -> c.common
  AnyNode -> anyCommon

withCommon :: CommonConstriction -> NodeConstriction -> NodeConstriction
withCommon common request = case request of
  ShapeNodeRequest _ shape -> ShapeNodeRequest common shape
  ContainerNodeRequest c -> ContainerNodeRequest { c | common = common }
  AnyNode -> AnyNode

🧶set_id :: (Feed Id, Feed Node) -> NodeConstriction -> Unravelled (Maybe Id, NodeConstriction)
🧶set_id _ request =
  let r = commonRequest request in
  case r.id of
    Just Nothing -> Snag
    Just (Just value) -> Unravel (Just value, withCommon { r | id = Nothing } request)
    Nothing -> Unravel (Nothing, request)

🧶set_opacity :: (Feed Float, Feed Node) -> NodeConstriction -> Unravelled (Maybe Float, NodeConstriction)
🧶set_opacity _ request =
  let r = commonRequest request in
  Unravel (r.opacity, withCommon { r | opacity = Nothing } request)

🧶set_visible :: (Feed Bool, Feed Node) -> NodeConstriction -> Unravelled (Maybe Bool, NodeConstriction)
🧶set_visible _ request =
  let r = commonRequest request in
  Unravel (r.visible, withCommon { r | visible = Nothing } request)

🧶set_transform :: (Feed Transform, Feed Node) -> NodeConstriction -> Unravelled (ListConstriction (Maybe TransformOp), NodeConstriction)
🧶set_transform _ request =
  let r = commonRequest request in
  Unravel (exactList r.transform, withCommon { r | transform = Nothing } request)

🧶set_closed :: (Feed Bool, Feed Node) -> NodeConstriction -> Unravelled (Maybe Bool, NodeConstriction)
🧶set_closed _ request = orSnag (extract takeClosed request)

takeClosed :: ShapeConstriction -> (Maybe Bool, ShapeConstriction)
takeClosed geometry = case geometry of
  RequestPolyline r -> (r.closed, RequestPolyline { r | closed = Nothing })
  _ -> (Nothing, geometry)

🧶set_optional_id :: (Feed (Maybe Id), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Maybe Id), NodeConstriction)
🧶set_optional_id _ request =
  let r = commonRequest request in
  Unravel (r.id, withCommon { r | id = Nothing } request)

🧶add_transform :: (Feed TransformOp, Feed Node) -> NodeConstriction -> Unravelled (Maybe TransformOp, NodeConstriction)
🧶add_transform _ request =
  let r = commonRequest request in
  case r.transform of
    Nothing -> Unravel (Nothing, request)
    Just [] -> Snag
    Just (operation : rest) -> Unravel (Just operation, withCommon { r | transform = Just rest } request)

🧶set_optional_view_box :: (Feed (Maybe ViewBox), Feed Container) -> ContainerConstriction -> Unravelled (Maybe (Maybe ViewBox), ContainerConstriction)
🧶set_optional_view_box _ request = case request.kind of
  ViewportKind r -> Unravel (r.viewBox, { request | kind = ViewportKind { r | viewBox = Nothing } })
  _ -> Unravel (Nothing, request)
