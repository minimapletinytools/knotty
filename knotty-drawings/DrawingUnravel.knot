🧶set_stroke_dashoffset :: (Feed (Float), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Float), NodeConstriction)
🧶set_stroke_dashoffset _ request = orSnag (extract strokeDashOffset request)

strokeMiterLimit :: ShapeConstriction -> (Maybe (Float), ShapeConstriction)
strokeMiterLimit geometry = case geometry of
  RequestRect r -> (r.stroke.miterLimit, RequestRect { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestCircle r -> (r.stroke.miterLimit, RequestCircle { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestEllipse r -> (r.stroke.miterLimit, RequestEllipse { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestLine r -> (r.stroke.miterLimit, RequestLine { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestPolyline r -> (r.stroke.miterLimit, RequestPolyline { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestPath r -> (r.stroke.miterLimit, RequestPath { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  RequestText r -> (r.stroke.miterLimit, RequestText { r | stroke = (let s = r.stroke in { s | miterLimit = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_stroke_miterlimit :: (Feed (Float), Feed Node) -> NodeConstriction -> Unravelled (Maybe (Float), NodeConstriction)
🧶set_stroke_miterlimit _ request = orSnag (extract strokeMiterLimit request)

fontFamily :: ShapeConstriction -> (Maybe (String), ShapeConstriction)
fontFamily geometry = case geometry of
  RequestText r -> (r.font.family, RequestText { r | font = (let s = r.font in { s | family = Nothing }) })
  _ -> (Nothing, geometry)

🧶set_font_family :: (Feed (String), Feed Node) -> NodeConstriction -> Unravelled (Maybe (String), NodeConstriction)
🧶set_font_family _ request = orSnag (extract fontFamily request)

