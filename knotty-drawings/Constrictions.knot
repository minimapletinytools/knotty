module Constrictions exposing (..)

-- Drawing-specific constrictions; the engine knows neither field names nor SVG.
import Types exposing (..)

type alias FillConstriction =
    { paint : Maybe (Paint)
    , opacity : Maybe (Float)
    , rule : Maybe (FillRule)
    }

anyFill :: FillConstriction
anyFill = { paint = Nothing, opacity = Nothing, rule = Nothing }

type alias StrokeConstriction =
    { paint : Maybe (Paint)
    , width : Maybe (Float)
    , opacity : Maybe (Float)
    , cap : Maybe (LineCap)
    , join : Maybe (LineJoin)
    , miterLimit : Maybe (Float)
    , dashes : Maybe (List Float)
    , dashOffset : Maybe (Float)
    }

anyStroke :: StrokeConstriction
anyStroke = { paint = Nothing, width = Nothing, opacity = Nothing, cap = Nothing, join = Nothing, miterLimit = Nothing, dashes = Nothing, dashOffset = Nothing }

type alias FontConstriction =
    { family : Maybe (String)
    , size : Maybe (Float)
    , anchor : Maybe (TextAnchor)
    , baseline : Maybe (DominantBaseline)
    }

anyFont :: FontConstriction
anyFont = { family = Nothing, size = Nothing, anchor = Nothing, baseline = Nothing }

type alias CommonConstriction =
    { id : Maybe (Maybe Id)
    , transform : Maybe (Transform)
    , opacity : Maybe (Float)
    , visible : Maybe (Bool)
    }

anyCommon :: CommonConstriction
anyCommon = { id = Nothing, transform = Nothing, opacity = Nothing, visible = Nothing }

type alias RectConstriction =
    { x : Maybe (Float)
    , y : Maybe (Float)
    , width : Maybe (Float)
    , height : Maybe (Float)
    , rx : Maybe (Float)
    , ry : Maybe (Float)
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyRect :: RectConstriction
anyRect = { x = Nothing, y = Nothing, width = Nothing, height = Nothing, rx = Nothing, ry = Nothing, fill = anyFill, stroke = anyStroke }

type alias CircleConstriction =
    { cx : Maybe (Float)
    , cy : Maybe (Float)
    , r : Maybe (Float)
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyCircle :: CircleConstriction
anyCircle = { cx = Nothing, cy = Nothing, r = Nothing, fill = anyFill, stroke = anyStroke }

type alias EllipseConstriction =
    { cx : Maybe (Float)
    , cy : Maybe (Float)
    , rx : Maybe (Float)
    , ry : Maybe (Float)
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyEllipse :: EllipseConstriction
anyEllipse = { cx = Nothing, cy = Nothing, rx = Nothing, ry = Nothing, fill = anyFill, stroke = anyStroke }

type alias LineConstriction =
    { x1 : Maybe (Float)
    , y1 : Maybe (Float)
    , x2 : Maybe (Float)
    , y2 : Maybe (Float)
    , stroke : StrokeConstriction
    }

anyLine :: LineConstriction
anyLine = { x1 = Nothing, y1 = Nothing, x2 = Nothing, y2 = Nothing, stroke = anyStroke }

type alias PolylineConstriction =
    { points : Maybe (List Point)
    , closed : Maybe (Bool)
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyPolyline :: PolylineConstriction
anyPolyline = { points = Nothing, closed = Nothing, fill = anyFill, stroke = anyStroke }

type alias PathConstriction =
    { commands : Maybe (List PathCommand)
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyPath :: PathConstriction
anyPath = { commands = Nothing, fill = anyFill, stroke = anyStroke }

type alias TextConstriction =
    { x : Maybe (Float)
    , y : Maybe (Float)
    , content : Maybe (String)
    , font : FontConstriction
    , fill : FillConstriction
    , stroke : StrokeConstriction
    }

anyText :: TextConstriction
anyText = { x = Nothing, y = Nothing, content = Nothing, font = anyFont, fill = anyFill, stroke = anyStroke }

type alias ViewportConstriction =
    { width : Maybe (Float)
    , height : Maybe (Float)
    , viewBox : Maybe (Maybe ViewBox)
    }

anyViewport :: ViewportConstriction
anyViewport = { width = Nothing, height = Nothing, viewBox = Nothing }

type ShapeConstriction
    = AnyShape
    | RequestRect RectConstriction
    | RequestCircle CircleConstriction
    | RequestEllipse EllipseConstriction
    | RequestLine LineConstriction
    | RequestPolyline PolylineConstriction
    | RequestPath PathConstriction
    | RequestText TextConstriction

instance Constriction ShapeConstriction Shape where
  fits request actual = case request of
    AnyShape -> True
    RequestRect r -> case actual of
      Rect v -> fits r v
      _ -> False
    RequestCircle r -> case actual of
      Circle v -> fits r v
      _ -> False
    RequestEllipse r -> case actual of
      Ellipse v -> fits r v
      _ -> False
    RequestLine r -> case actual of
      Line v -> fits r v
      _ -> False
    RequestPolyline r -> case actual of
      Polyline v -> fits r v
      _ -> False
    RequestPath r -> case actual of
      Path v -> fits r v
      _ -> False
    RequestText r -> case actual of
      Text v -> fits r v
      _ -> False

type KindConstriction = AnyKind | GroupKind | ViewportKind ViewportConstriction

instance Constriction KindConstriction ContainerKind where
  fits request actual = case request of
    AnyKind -> True
    GroupKind -> case actual of
      Group -> True
      _ -> False
    ViewportKind r -> case actual of
      Viewport v -> fits r v
      _ -> False

type alias ContainerConstriction =
    { kind : KindConstriction
    , common : CommonConstriction
    , children : ListConstriction NodeConstriction
    }

type NodeConstriction
    = AnyNode
    | ShapeNodeRequest CommonConstriction ShapeConstriction
    | ContainerNodeRequest ContainerConstriction

instance Constriction NodeConstriction Node where
  fits request actual = case request of
    AnyNode -> True
    ShapeNodeRequest common geometry -> case actual of
      ShapeNode c g -> fits common c && fits geometry g
      _ -> False
    ContainerNodeRequest r -> case actual of
      ContainerNode c -> fits r c
      _ -> False

anyContainer :: ContainerConstriction
anyContainer = { kind = AnyKind, common = anyCommon, children = AnyRemainder }

-- Positions are revision-local. An out-of-range request fails validation;
-- negative indices are rejected before building a constriction.
nodeAt :: List Int -> NodeConstriction -> Maybe ContainerConstriction
nodeAt path request = case path of
  [] -> Nothing
  index : rest ->
    if index < 0 then Nothing else
      case rest of
        [] -> Just { anyContainer | children = slot index request }
        _ -> case nodeAt rest request of
          Nothing -> Nothing
          Just child -> Just { anyContainer | children = slot index (ContainerNodeRequest child) }

slot :: Int -> NodeConstriction -> ListConstriction NodeConstriction
slot index request =
  if index <= 0 then Prepend request AnyRemainder
  else Prepend AnyNode (slot (index - 1) request)
