module DrawingBack exposing (..)

import Types exposing (..)
import Requests exposing (..)

type alias Feed a = { value : a, pinned : Maybe a }

-- A distinct request type makes creation an explicit editableShapes policy.
-- Registering its constructor recipe does not enable growth on every Node list.
type ShapeAdditions = ShapeAdditions (ListConstraint NodeRequest)

finiteCoordinate :: Float -> Bool
finiteCoordinate n = not (isNaN n || isInfinite n)

instance Constriction ShapeAdditions (List Node) where
  fits (ShapeAdditions request) actual = fits request actual
  materialize (ShapeAdditions request) = case request of
    Prepend (ShapeNodeRequest _ (RequestRect box)) ExactEnd -> do
      x <- box.x
      y <- box.y
      width <- box.width
      height <- box.height
      if width > 0 && height > 0 && all finiteCoordinate [x, y, width, height]
      then pure [ShapeNode defaultCommon (Rect { x = x, y = y, width = width, height = height, rx = 0, ry = 0, fill = defaultFill, stroke = defaultStroke })] else Nothing
    Prepend (ShapeNodeRequest _ (RequestEllipse oval)) ExactEnd -> do
      cx <- oval.cx
      cy <- oval.cy
      rx <- oval.rx
      ry <- oval.ry
      if rx > 0 && ry > 0 && all finiteCoordinate [cx, cy, rx, ry]
      then pure [ShapeNode defaultCommon (Ellipse { cx = cx, cy = cy, rx = rx, ry = ry, fill = defaultFill, stroke = defaultStroke })] else Nothing
    _ -> do
      (cx, cy, r) <- circleAdditionArguments { value = [], pinned = Nothing } (ShapeAdditions request)
      pure [ShapeNode defaultCommon (Circle { cx = cx, cy = cy, r = r, fill = defaultFill, stroke = defaultStroke })]

🧶EditableShapes :: (Feed (List Node), Feed (List Node)) -> ListConstraint NodeRequest -> Maybe (ListConstraint NodeRequest, ShapeAdditions)
🧶EditableShapes (generated, additions) request = do
  (left, right) <- splitListRequest (effectiveFeed generated) request
  let wanted = ShapeAdditions right
  if pinAllows generated left && pinAllows additions wanted
  then Just (left, wanted) else Nothing

unravelShapeAdditions :: (Feed Node, Feed (List Node)) -> ShapeAdditions -> Maybe (FieldRequest NodeRequest, FieldRequest ShapeAdditions)
unravelShapeAdditions _ (ShapeAdditions request) = case request of
  AnyRemainder -> Just (NoRequest, NoRequest)
  ExactEnd -> Nothing
  Prepend head tail -> Just (RequestField head, RequestField (ShapeAdditions tail))

-- One new circle per creation transaction. Existing slots are decomposed above;
-- only an empty suffix is materialized. Reuse the circle's normal reverse rule
-- with a fixed factory seed, then materialize the resulting constructor value.
circleAdditionArguments :: Feed (List Node) -> ShapeAdditions -> Maybe (Float, Float, Float)
circleAdditionArguments input (ShapeAdditions request) = case input.value of
  _ : _ -> Nothing
  [] -> case request of
    Prepend wanted ExactEnd -> do
      let x = { value = 0.0, pinned = Nothing }
      let y = { value = 0.0, pinned = Nothing }
      let radius = { value = 10.0, pinned = Nothing }
      (rx, ry, rr) <- 🧶Circle (x, y, radius) wanted
      cx <- chooseExact x rx
      cy <- chooseExact y ry
      r <- chooseExact radius rr
      if r > 0 && all finiteCoordinate [cx, cy, r]
      then Just (cx, cy, r) else Nothing
    _ -> Nothing

-- Raw materialized constructors retain normal field routes on later edits.
unravelShapeNode :: (Feed Common, Feed Shape) -> NodeRequest -> Maybe (CommonRequest, ShapeRequest)
unravelShapeNode _ request = case request of
  AnyNode -> Just (anyCommon, AnyShape)
  ShapeNodeRequest common shape -> Just (common, shape)
  _ -> Nothing

unravelCircleShape :: Feed Circle -> ShapeRequest -> Maybe CircleRequest
unravelCircleShape _ request = case request of
  AnyShape -> Just anyCircle
  RequestCircle circle -> Just circle
  _ -> Nothing

unravelRectShape :: Feed Rect -> ShapeRequest -> Maybe RectRequest
unravelRectShape _ request = case request of
  AnyShape -> Just anyRect
  RequestRect rect -> Just rect
  _ -> Nothing

unravelEllipseShape :: Feed Ellipse -> ShapeRequest -> Maybe EllipseRequest
unravelEllipseShape _ request = case request of
  AnyShape -> Just anyEllipse
  RequestEllipse ellipse -> Just ellipse
  _ -> Nothing

-- Rules route requests to existing source arguments. Fixed constructor defaults
-- and pins are checked by the engine before any source is published.

🧶Rect :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶Rect _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing, Nothing)
    RequestRect r -> Just (r.x, r.y, r.width, r.height)
    _ -> Nothing
  _ -> Nothing

🧶RoundedRect :: (Feed Float, Feed Float, Feed Float, Feed Float, Feed Float) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶RoundedRect _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing, Nothing, Nothing)
    RequestRect r -> case merge r.rx r.ry of
      Nothing -> Nothing
      Just radius -> Just (r.x, r.y, r.width, r.height, radius)
    _ -> Nothing
  _ -> Nothing

🧶Circle :: (Feed Float, Feed Float, Feed Float) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float)
🧶Circle _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing)
    RequestCircle r -> Just (r.cx, r.cy, r.r)
    _ -> Nothing
  _ -> Nothing

🧶Ellipse :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶Ellipse _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing, Nothing)
    RequestEllipse r -> Just (r.cx, r.cy, r.rx, r.ry)
    _ -> Nothing
  _ -> Nothing

🧶Line :: (Feed Float, Feed Float, Feed Float, Feed Float) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float, Maybe Float)
🧶Line _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing, Nothing)
    RequestLine r -> Just (r.x1, r.y1, r.x2, r.y2)
    _ -> Nothing
  _ -> Nothing

🧶Text :: (Feed Float, Feed Float, Feed String) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, Maybe String)
🧶Text _ request = case request of
  AnyNode -> Just (Nothing, Nothing, Nothing)
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just (Nothing, Nothing, Nothing)
    RequestText r -> Just (r.x, r.y, r.content)
    _ -> Nothing
  _ -> Nothing

-- Exact list requests preserve the original number of source elements. Growth
-- still needs the engine's prepared-draft protocol; it is not silently invented.
exactList :: Maybe (List a) -> ListConstraint (Maybe a)
exactList request = case request of
  Nothing -> AnyRemainder
  Just values -> exactItems values

exactItems :: List a -> ListConstraint (Maybe a)
exactItems values = case values of
  [] -> ExactEnd
  x : xs -> Prepend (Just x) (exactItems xs)

type alias PointRequest = { x : Maybe Float, y : Maybe Float }
pointList :: Maybe (List Point) -> ListConstraint PointRequest
pointList request = case request of
  Nothing -> AnyRemainder
  Just values -> pointItems values

pointItems :: List Point -> ListConstraint PointRequest
pointItems values = case values of
  [] -> ExactEnd
  p : ps -> Prepend { x = Just p.x, y = Just p.y } (pointItems ps)

🧶Polyline :: Feed (List Point) -> NodeRequest -> Maybe (ListConstraint PointRequest)
🧶Polyline _ request = case request of
  AnyNode -> Just AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just AnyRemainder
    RequestPolyline r -> Just (pointList r.points)
    _ -> Nothing
  _ -> Nothing

🧶Polygon :: Feed (List Point) -> NodeRequest -> Maybe (ListConstraint PointRequest)
🧶Polygon _ request = case request of
  AnyNode -> Just AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just AnyRemainder
    RequestPolyline r -> Just (pointList r.points)
    _ -> Nothing
  _ -> Nothing

🧶Path :: Feed (List PathCommand) -> NodeRequest -> Maybe (ListConstraint (Maybe PathCommand))
🧶Path _ request = case request of
  AnyNode -> Just AnyRemainder
  ShapeNodeRequest _ geometry -> case geometry of
    AnyShape -> Just AnyRemainder
    RequestPath r -> Just (exactList r.commands)
    _ -> Nothing
  _ -> Nothing

🧶Group :: Feed (List Node) -> NodeRequest -> Maybe (ListConstraint NodeRequest)
🧶Group _ request = case request of
  AnyNode -> Just AnyRemainder
  ContainerNodeRequest r -> Just r.children
  _ -> Nothing

🧶Svg :: (Feed Float, Feed Float, Feed (List Node)) -> ContainerRequest -> Maybe (Maybe Float, Maybe Float, ListConstraint NodeRequest)
🧶Svg _ request = case request.kind of
  AnyKind -> Just (Nothing, Nothing, request.children)
  ViewportKind r -> Just (r.width, r.height, request.children)
  GroupKind -> Nothing

🧶NestedSvg :: (Feed Float, Feed Float, Feed (List Node)) -> NodeRequest -> Maybe (Maybe Float, Maybe Float, ListConstraint NodeRequest)
🧶NestedSvg inputs request = case request of
  AnyNode -> Just (Nothing, Nothing, AnyRemainder)
  ContainerNodeRequest r -> 🧶Svg inputs r
  _ -> Nothing

🧶ViewBox :: (Feed Float, Feed Float, Feed Float, Feed Float, Feed Container) -> ContainerRequest -> Maybe (Maybe Float, Maybe Float, Maybe Float, Maybe Float, ContainerRequest)
🧶ViewBox _ request = case request.kind of
  ViewportKind r -> case r.viewBox of
    Just (Just b) -> Just (Just b.minX, Just b.minY, Just b.width, Just b.height, { request | kind = ViewportKind { r | viewBox = Nothing } })
    Just Nothing -> Nothing
    Nothing -> Just (Nothing, Nothing, Nothing, Nothing, request)
  _ -> Just (Nothing, Nothing, Nothing, Nothing, request)

-- A shared style setter can affect several descendants. Merge equal requests;
-- reject incompatible ones instead of arbitrarily choosing one child.
merge :: Eq a => Maybe a -> Maybe a -> Maybe (Maybe a)
merge left right = case (left, right) of
  (Nothing, _) -> Just right
  (_, Nothing) -> Just left
  (Just a, Just b) -> if a == b then Just left else Nothing

extract :: Eq a => (ShapeRequest -> (Maybe a, ShapeRequest)) -> NodeRequest -> Maybe (Maybe a, NodeRequest)
extract take request = case request of
  AnyNode -> Just (Nothing, AnyNode)
  ShapeNodeRequest common geometry ->
    let (value, rest) = take geometry in Just (value, ShapeNodeRequest common rest)
  ContainerNodeRequest container -> case extractChildren take container.children of
    Nothing -> Nothing
    Just (value, children) -> Just (value, ContainerNodeRequest { container | children = children })

extractChildren :: Eq a => (ShapeRequest -> (Maybe a, ShapeRequest)) -> ListConstraint NodeRequest -> Maybe (Maybe a, ListConstraint NodeRequest)
extractChildren take children = case children of
  AnyRemainder -> Just (Nothing, AnyRemainder)
  ExactEnd -> Just (Nothing, ExactEnd)
  Prepend node rest -> case (extract take node, extractChildren take rest) of
    (Just (a, nodeRest), Just (b, tailRest)) -> case merge a b of
      Nothing -> Nothing
      Just value -> Just (value, Prepend nodeRest tailRest)
    _ -> Nothing

fillPaint :: ShapeRequest -> (Maybe (Paint), ShapeRequest)
fillPaint geometry = case geometry of
  RequestRect r -> (r.fill.paint, RequestRect { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestCircle r -> (r.fill.paint, RequestCircle { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestEllipse r -> (r.fill.paint, RequestEllipse { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestPolyline r -> (r.fill.paint, RequestPolyline { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestPath r -> (r.fill.paint, RequestPath { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  RequestText r -> (r.fill.paint, RequestText { r | fill = (let s = r.fill in { s | paint = Nothing }) })
  _ -> (Nothing, geometry)

🧶Fill :: (Feed (Color), Feed Node) -> NodeRequest -> Maybe (Maybe (Color), NodeRequest)
🧶Fill _ request = case extract fillPaint request of
  Just (Nothing, rest) -> Just (Nothing, rest)
  Just (Just (Solid color), rest) -> Just (Just color, rest)
  _ -> Nothing

strokePaint :: ShapeRequest -> (Maybe (Paint), ShapeRequest)
strokePaint geometry = case geometry of
  RequestRect r -> (r.stroke.paint, RequestRect { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestCircle r -> (r.stroke.paint, RequestCircle { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestEllipse r -> (r.stroke.paint, RequestEllipse { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestLine r -> (r.stroke.paint, RequestLine { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestPolyline r -> (r.stroke.paint, RequestPolyline { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestPath r -> (r.stroke.paint, RequestPath { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  RequestText r -> (r.stroke.paint, RequestText { r | stroke = (let s = r.stroke in { s | paint = Nothing }) })
  _ -> (Nothing, geometry)

🧶Stroke :: (Feed (Color), Feed Node) -> NodeRequest -> Maybe (Maybe (Color), NodeRequest)
🧶Stroke _ request = case extract strokePaint request of
  Just (Nothing, rest) -> Just (Nothing, rest)
  Just (Just (Solid color), rest) -> Just (Just color, rest)
  _ -> Nothing

🧶FillPaint :: (Feed (Paint), Feed Node) -> NodeRequest -> Maybe (Maybe (Paint), NodeRequest)
🧶FillPaint _ request = extract fillPaint request

🧶StrokePaint :: (Feed (Paint), Feed Node) -> NodeRequest -> Maybe (Maybe (Paint), NodeRequest)
🧶StrokePaint _ request = extract strokePaint request

