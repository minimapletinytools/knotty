🧶NoFill :: Feed Node -> NodeRequest -> Maybe NodeRequest
🧶NoFill _ request = case extract fillPaint request of
  Just (Nothing, rest) -> Just rest
  Just (Just NoPaint, rest) -> Just rest
  _ -> Nothing

🧶NoStroke :: Feed Node -> NodeRequest -> Maybe NodeRequest
🧶NoStroke _ request = case extract strokePaint request of
  Just (Nothing, rest) -> Just rest
  Just (Just NoPaint, rest) -> Just rest
  _ -> Nothing

-- Common setters affect this node only, unlike recursive style setters.
commonRequest :: NodeRequest -> CommonRequest
commonRequest request = case request of
  ShapeNodeRequest common _ -> common
  ContainerNodeRequest c -> c.common
  AnyNode -> anyCommon

withCommon :: CommonRequest -> NodeRequest -> NodeRequest
withCommon common request = case request of
  ShapeNodeRequest _ shape -> ShapeNodeRequest common shape
  ContainerNodeRequest c -> ContainerNodeRequest { c | common = common }
  AnyNode -> AnyNode

🧶Id :: (Feed Id, Feed Node) -> NodeRequest -> Maybe (Maybe Id, NodeRequest)
🧶Id _ request =
  let r = commonRequest request in
  case r.id of
    Just Nothing -> Nothing
    Just (Just value) -> Just (Just value, withCommon { r | id = Nothing } request)
    Nothing -> Just (Nothing, request)

🧶Opacity :: (Feed Float, Feed Node) -> NodeRequest -> Maybe (Maybe Float, NodeRequest)
🧶Opacity _ request =
  let r = commonRequest request in
  Just (r.opacity, withCommon { r | opacity = Nothing } request)

🧶Visible :: (Feed Bool, Feed Node) -> NodeRequest -> Maybe (Maybe Bool, NodeRequest)
🧶Visible _ request =
  let r = commonRequest request in
  Just (r.visible, withCommon { r | visible = Nothing } request)

🧶Transform :: (Feed Transform, Feed Node) -> NodeRequest -> Maybe (ListConstraint (Maybe TransformOp), NodeRequest)
🧶Transform _ request =
  let r = commonRequest request in
  Just (exactList r.transform, withCommon { r | transform = Nothing } request)

🧶Closed :: (Feed Bool, Feed Node) -> NodeRequest -> Maybe (Maybe Bool, NodeRequest)
🧶Closed _ request = extract takeClosed request

takeClosed :: ShapeRequest -> (Maybe Bool, ShapeRequest)
takeClosed geometry = case geometry of
  RequestPolyline r -> (r.closed, RequestPolyline { r | closed = Nothing })
  _ -> (Nothing, geometry)

🧶OptionalId :: (Feed (Maybe Id), Feed Node) -> NodeRequest -> Maybe (Maybe (Maybe Id), NodeRequest)
🧶OptionalId _ request =
  let r = commonRequest request in
  Just (r.id, withCommon { r | id = Nothing } request)

🧶AddTransform :: (Feed TransformOp, Feed Node) -> NodeRequest -> Maybe (Maybe TransformOp, NodeRequest)
🧶AddTransform _ request =
  let r = commonRequest request in
  case r.transform of
    Nothing -> Just (Nothing, request)
    Just [] -> Nothing
    Just (operation : rest) -> Just (Just operation, withCommon { r | transform = Just rest } request)

🧶OptionalViewBox :: (Feed (Maybe ViewBox), Feed Container) -> ContainerRequest -> Maybe (Maybe (Maybe ViewBox), ContainerRequest)
🧶OptionalViewBox _ request = case request.kind of
  ViewportKind r -> Just (r.viewBox, { request | kind = ViewportKind { r | viewBox = Nothing } })
  _ -> Just (Nothing, request)
